# Copy this to .env on the machine that runs GPT Image generation.
# Do not commit the real file.
OPENAI_API_KEY=sk-proj-your-openai-key

# Optional, used by scripts/download_ltx_models.sh if models are missing.
HF_TOKEN=hf_your_huggingface_token

# Optional, only if uploading to Google Drive from Vast.
RCLONE_REMOTE=gdrive
DRIVE_OUTPUT_DIR=Japan_Project_Render_Workflow/final
